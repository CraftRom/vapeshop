# ============================================================ Telegram
# Токен від @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Юзернейм бота без @ — потрібен для реферальних посилань
BOT_USERNAME=your_shop_bot

# ID групи/каналу, куди падають нові замовлення (від'ємне число для груп).
# Дізнатися: додайте @getmyid_bot у групу.
ADMIN_CHAT_ID=-1001234567890

# Хто має доступ до /stats і кнопок статусу в боті. Через кому.
ADMIN_IDS=123456789

# ============================================================ Користувач у контейнерах
# UID/GID, від якого працюють процеси всередині контейнерів. Мають
# збігатися з користувачем на хості, який володіє текою data, — інакше
# застосунок не зможе туди писати, або запише файли, які ви потім не
# видалите без sudo. bootstrap.sh підставляє сюди `id -u shop`.
APP_UID=1000
APP_GID=1000

# ============================================================ База даних
# Postgres у контейнері поруч. Назовні не відкривається: сервіси спілкуються
# з ним у внутрішній мережі Docker, тому порт 5432 у фаєрволі не потрібен.
#
# POSTGRES_PASSWORD і DATABASE_URL мають містити той самий пароль —
# bootstrap.sh підставляє згенерований в обидва.
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=shop
DATABASE_URL=postgresql+asyncpg://shop:change_this_password@db:5432/shop

# ============================================================ Дашборд
# Згенерувати: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=change_this_to_a_fernet_key
JWT_TTL_HOURS=12

DASHBOARD_LOGIN=admin
DASHBOARD_PASSWORD=change_this_password_too

# Звідки дозволено звертатися до API. У проді — домен дашборду.
CORS_ORIGINS=http://localhost:5173,http://localhost

# ============================================================ Магазин
SHOP_NAME=Lux Opt
CURRENCY=грн
MIN_AGE=18

# Реферальна програма
REFERRAL_PERCENT=5
BONUS_MAX_PERCENT=30

# Довідник Нової пошти: список міст і відділень у формі замовлення.
# Порожньо — форма працює як раніше, адреса вписується руками.
# Зазвичай задається не тут, а в панелі: Налаштування → Доставка.
NOVAPOSHTA_API_KEY=
# Місто відправлення й припущена вага позиції — для попереднього
# розрахунку доставки. Без них вітрина показує «від» із DELIVERY_COST_FROM.
NOVAPOSHTA_SENDER_CITY=
# Відправник для ТТН з панелі. Контрагента й контактну особу панель
# знаходить за ключем сама; код відділення — Ref із довідника Нової пошти.
NOVAPOSHTA_SENDER_PHONE=
NOVAPOSHTA_SENDER_WAREHOUSE_REF=

# SalesDrive. Зручніше налаштовувати в панелі (Налаштування → SalesDrive,
# лише системний адміністратор): там же генерується адреса вебхука.
# Значення з панелі перекривають ці.
SALESDRIVE_ENABLED=false
SALESDRIVE_DOMAIN=
SALESDRIVE_FORM_KEY=
# ID бази заявок SalesDrive «ELFAR — Telegram Bot» (data.formId у webhook).
# Обовʼязковий fail-closed guard: 0/порожньо блокує синхронізацію.
SALESDRIVE_API_KEY=
# Read-side синхронізація пов'язаних заявок: без відкриття картки менеджером.
# Кожні 60 с scheduler бере невелику порцію snapshot-ів, які застаріли.
SALESDRIVE_BACKGROUND_REFRESH_SECONDS=60
SALESDRIVE_BACKGROUND_BATCH=20
DELIVERY_WEIGHT_PER_ITEM=0.5
# Курʼєр на адресу. Вимкнений за замовчуванням: доступний не всюди.
DELIVERY_COURIER_ENABLED=false

# Відповіді бота на ключові слова в групових чатах. false — бот
# відповідає в групі лише тоді, коли до нього звертаються прямо.
FAQ_PUBLIC_ENABLED=true
# Окремо для робочого чату з замовленнями: там працює команда, і довідка
# для клієнтів посеред їхньої розмови зайва.
FAQ_ADMIN_CHAT_ENABLED=false

# Реквізити для оплати переказом
CARD_NUMBER=0000 0000 0000 0000
CARD_HOLDER=Prizvyshche Imia

# ============================================================ Режим роботи
# Вимикає пул зʼєднань. На власному сервері має лишатись false:
# пул тут потрібен, процес довгоживучий.
SERVERLESS=false

# Redis для FSM. Без нього багатокрокове оформлення губиться при рестарті,
# а в serverless ламається зовсім.
#   свій сервер: redis://redis:6379/0
#   Upstash:     rediss://...
REDIS_PASSWORD=change_this_redis_password
REDIS_URL=redis://:change_this_redis_password@redis:6379/0

# Потрібно лише для режиму вебхука. За замовчуванням бот працює
# на polling, і секрет не потрібен.
PUBLIC_URL=
WEBHOOK_SECRET=
CRON_SECRET=

# --- Планувальник ---------------------------------------------------------
# Базовий інтервал scheduler. Для CRM він автоматично обмежується
# SALESDRIVE_BACKGROUND_REFRESH_SECONDS, тому старе 3600 не блокує live-sync.
SCHEDULER_INTERVAL_SECONDS=3600

# --- Журнал -------------------------------------------------------------
# Два різні шляхи, і їх легко переплутати:
#
#
# сам по собі він нічого не переносить — файли все одно опиняться там,
# куди вказує монтування.
#
# За замовчуванням логи лягають у deploy/logs, поруч із deploy/backups.
# Якщо хочете тримати їх у системному місці:
#   sudo install -d -o shop -g shop -m 750 /var/log/elfar
# json — машиночитаний формат, як у serverless-платформ: один запис
# на рядок, фільтрується через jq. 0 — читабельний текст для розробки.
LOG_JSON=1
# NOTSET (0)   — геть усе, включно з чужими бібліотеками
# DEBUG (10)   — подробиці для розслідування
# INFO (20)    — звичайний робочий журнал
# WARNING (30) — лише те, що варте уваги
# ERROR (40)   — лише помилки
# CRITICAL (50)— лише падіння
# Приймаються також WARN, FATAL, TRACE і будь-яке число 0–100.
LOG_LEVEL=INFO
# Скільки місця відведено журналам. Файл сервісу росте до LOG_MAX_MB, потім
# починається заново, а попередній лягає поруч під номером; таких копій
# зберігається LOG_BACKUPS. Верхня межа на диску:
#
#   3 сервіси × LOG_MAX_MB × (LOG_BACKUPS + 1) = 180 МБ за замовчуванням
#
# Це стеля, а не поточний розмір: понад неї журнали не виростуть навіть за
# нічний цикл помилок. На тісному VPS її можна опустити тут, не чіпаючи код.
# Менше мегабайта ставити не варто — файл прокручуватиметься швидше, ніж
# устигаєш його прочитати, і остання година подій зникне з-під носа.
LOG_MAX_MB=10
LOG_BACKUPS=5

# Стримування підбору пароля до панелі. Обмеження в nginx рахує спроби за
# адресою — проти підбору з десяти адрес одночасно воно безсиле. Тут
# рахуємо невдалі спроби ПОСПІЛЬ на обліковий запис, звідки б вони не
# приходили. Успішний вхід обнуляє лічильник.
#
# Менше трьох спроб ставити не варто: людина заблокує себе сама,
# переплутавши розкладку. Чверть години зупиняє перебір і не перетворює
# друкарську помилку на втрачений робочий день.
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15
# Куди лягають дампи. Має збігатися з томом, змонтованим у сервіс scheduler.
# Тека на сервері для дампів. Та сама логіка, що й з логами:

# Решта параметрів розсилок і бекапів — часовий пояс, тихі години, темп,
# година бекапу, ретенція — задаються в панелі, а не тут: їх міняють
# частіше, ніж передеплоюють.
