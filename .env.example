# ============================================================ Telegram
# Токен від @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Юзернейм бота без @ — потрібен для реферальних посилань
BOT_USERNAME=your_shop_bot

# ID групи/каналу, куди падають нові замовлення (від'ємне число для груп).
# Дізнатися: додайте @getmyid_bot у групу.
ADMIN_CHAT_ID=-1001234567890

# Хто має доступ до /stats і кнопок статусу в боті. Через кому.
ADMIN_IDS=123456789

# ============================================================ База даних
# Postgres у контейнері поруч. Назовні не відкривається: сервіси спілкуються
# з ним у внутрішній мережі Docker, тому порт 5432 у фаєрволі не потрібен.
#
# POSTGRES_PASSWORD і DATABASE_URL мають містити той самий пароль —
# bootstrap.sh підставляє згенерований в обидва.
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=shop
DATABASE_URL=postgresql+asyncpg://shop:change_this_password@db:5432/shop

# ============================================================ Дашборд
# Згенерувати: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
JWT_TTL_HOURS=12

DASHBOARD_LOGIN=admin
DASHBOARD_PASSWORD=change_this_password_too

# Звідки дозволено звертатися до API. У проді — домен дашборду.
CORS_ORIGINS=http://localhost:5173,http://localhost

# ============================================================ Магазин
SHOP_NAME=Lux Opt
CURRENCY=грн
MIN_AGE=18

# Реферальна програма
REFERRAL_PERCENT=5
BONUS_MAX_PERCENT=30

# Реквізити для оплати переказом
CARD_NUMBER=0000 0000 0000 0000
CARD_HOLDER=Prizvyshche Imia

# ============================================================ Режим роботи
# Вимикає пул зʼєднань. На власному сервері має лишатись false:
# пул тут потрібен, процес довгоживучий.
SERVERLESS=false

# Redis для FSM. Без нього багатокрокове оформлення губиться при рестарті,
# а в serverless ламається зовсім.
#   свій сервер: redis://redis:6379/0
#   Upstash:     rediss://...
REDIS_URL=

# Потрібно лише для режиму вебхука. За замовчуванням бот працює
# на polling, і секрет не потрібен.
PUBLIC_URL=
WEBHOOK_SECRET=
CRON_SECRET=

# --- Планувальник ---------------------------------------------------------
# Як часто сервіс scheduler перевіряє чергу розсилок і час бекапу, у секундах.
# Година — компроміс: точність планування теж годинна, тож частіше прокидатися
# означало б лише зайві запити до бази цілодобово.
SCHEDULER_INTERVAL_SECONDS=3600
# Куди лягають дампи. Має збігатися з томом, змонтованим у сервіс scheduler.
BACKUP_DIR=/backups

# Решта параметрів розсилок і бекапів — часовий пояс, тихі години, темп,
# година бекапу, ретенція — задаються в панелі, а не тут: їх міняють
# частіше, ніж передеплоюють.
