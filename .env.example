# ============================================================ Telegram
# Токен від @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Юзернейм бота без @ — потрібен для реферальних посилань
BOT_USERNAME=your_shop_bot

# ID групи/каналу, куди падають нові замовлення (від'ємне число для груп).
# Дізнатися: додайте @getmyid_bot у групу.
ADMIN_CHAT_ID=-1001234567890

# Хто має доступ до /stats і кнопок статусу в боті. Через кому.
ADMIN_IDS=123456789

# ============================================================ Вибір бази
# sql       — Postgres/SQLite через SQLAlchemy (власний сервер)
# firestore — Firebase Firestore (Vercel та інший serverless)
DB_BACKEND=sql

# Тільки для DB_BACKEND=firestore.
# Автентифікація — через GOOGLE_APPLICATION_CREDENTIALS (шлях до JSON
# сервісного акаунта) або GOOGLE_APPLICATION_CREDENTIALS_JSON (вміст файлу,
# зручніше для Vercel — див. docs/FIREBASE.md).
FIREBASE_PROJECT=
FIREBASE_DATABASE=

# ============================================================ База даних (DB_BACKEND=sql)
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=shop
DATABASE_URL=postgresql+asyncpg://shop:change_this_password@db:5432/shop

# ============================================================ Дашборд
# Згенерувати: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
JWT_TTL_HOURS=12

DASHBOARD_LOGIN=admin
DASHBOARD_PASSWORD=change_this_password_too

# Звідки дозволено звертатися до API. У проді — домен дашборду.
CORS_ORIGINS=http://localhost:5173,http://localhost

# ============================================================ Магазин
SHOP_NAME=Lux Opt
CURRENCY=грн
MIN_AGE=18

# Реферальна програма
REFERRAL_PERCENT=5
BONUS_MAX_PERCENT=30

# Реквізити для оплати переказом
CARD_NUMBER=0000 0000 0000 0000
CARD_HOLDER=Prizvyshche Imia

# ============================================================ Режим роботи
# true — для Vercel/serverless: вимикає пул з'єднань і init_db на старті
SERVERLESS=false

# Redis для FSM. Без нього багатокрокове оформлення губиться при рестарті,
# а в serverless ламається зовсім.
#   свій сервер: redis://redis:6379/0
#   Upstash:     rediss://...
REDIS_URL=

# Потрібно лише для режиму вебхука (обов'язково на Vercel)
PUBLIC_URL=
WEBHOOK_SECRET=
CRON_SECRET=
