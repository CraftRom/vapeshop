# ============================================================ Telegram
# Токен від @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Юзернейм бота без @ — потрібен для реферальних посилань
BOT_USERNAME=your_shop_bot

# ID групи/каналу, куди падають нові замовлення (від'ємне число для груп).
# Дізнатися: додайте @getmyid_bot у групу.
ADMIN_CHAT_ID=-1001234567890

# Хто має доступ до /stats і кнопок статусу в боті. Через кому.
ADMIN_IDS=123456789

# ============================================================ База даних
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=shop
DATABASE_URL=postgresql+asyncpg://shop:change_this_password@db:5432/shop

# ============================================================ Дашборд
# Згенерувати: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
JWT_TTL_HOURS=12

DASHBOARD_LOGIN=admin
DASHBOARD_PASSWORD=change_this_password_too

# Звідки дозволено звертатися до API. У проді — домен дашборду.
CORS_ORIGINS=http://localhost:5173,http://localhost

# ============================================================ Магазин
SHOP_NAME=Lux Opt
CURRENCY=грн
MIN_AGE=18

# Реферальна програма
REFERRAL_PERCENT=5
BONUS_MAX_PERCENT=30

# Реквізити для оплати переказом
CARD_NUMBER=0000 0000 0000 0000
CARD_HOLDER=Прізвище Ім'я
