{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "backend/**",
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "dashboard/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "miniapp/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/docs",
      "dest": "/api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/index.py"
    },
    {
      "src": "/app",
      "dest": "/miniapp/index.html"
    },
    {
      "src": "/app/",
      "dest": "/miniapp/index.html"
    },
    {
      "src": "/app/(.+)",
      "dest": "/miniapp/$1"
    },
    {
      "src": "/",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/dashboard/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/miniapp/(.*)",
      "dest": "/miniapp/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/dashboard/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/broadcast-tick",
      "schedule": "0 4 * * *"
    }
  ]
}
