rules_version = '2';

// База доступна ЛИШЕ бекенду через сервісний акаунт (Admin SDK обходить правила).
// Клієнтських звернень до Firestore у цьому проєкті немає — ані з бота,
// ані з панелі. Тому найбезпечніше правило: заборонити все.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
